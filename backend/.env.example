# Copy to .env and replace both placeholders with locally generated secrets.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql://ecommerce:replace_with_random_hex@localhost:5432/ecommerce?schema=public
JWT_SECRET=replace_with_at_least_32_random_hex_characters
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
